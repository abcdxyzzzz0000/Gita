{
  "name": "bhagavad-gita-app",
  "version": "1.0.0",
  "private": true,
  "description": "Bhagavad Gita Learning Application - A modern platform for learning the Gita",
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "frontend:start": "cd frontend && npx expo start",
    "frontend:web": "cd frontend && npx expo start --web",
    "frontend:android": "cd frontend && npx expo start --android",
    "frontend:ios": "cd frontend && npx expo start --ios",
    "backend:dev": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:test": "cd backend && pytest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
